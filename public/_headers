# Cloudflare Pages reads this file. Vite copies it from public/ into dist/.
#
# How long a browser may reuse a file before asking the server for it again.
# PageSpeed's "Use efficient cache lifetimes" flagged this on the previous
# host, where the headers were set for us and could not be changed.
#
# Rules are matched top to bottom and every matching rule applies, with a later
# one winning where they set the same header. So the catch-all below sets the
# cautious default and the specific rules after it relax that for files whose
# names change when their contents do.

/*
  Cache-Control: public, max-age=0, must-revalidate
  # A page that is not meant to be framed, so it cannot be dropped into a
  # copycat site and passed off as that site's own checkout.
  X-Frame-Options: SAMEORIGIN
  # Stops a browser guessing that a file is something other than what we said
  # it is, which is how an upload can end up being run as a script.
  X-Content-Type-Options: nosniff
  # Other sites see that traffic came from jaydascents.com, but not which page
  # the visitor was reading.
  Referrer-Policy: strict-origin-when-cross-origin

# Vite stamps a hash of the contents into every filename here, so a file that
# changes gets a new name. The old name can safely be kept forever, and
# immutable tells the browser not to even check.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Font filenames are not hashed, but a font only changes if we swap the
# typeface, which would mean a new filename anyway. A year, without immutable,
# so a hard refresh can still fetch a replacement.
/fonts/*
  Cache-Control: public, max-age=31536000

# Photos keep their names when a product is reshot, so a month rather than a
# year: long enough to help someone browsing the shop over several visits,
# short enough that a corrected photo reaches people without them having to
# clear anything.
/images/*
  Cache-Control: public, max-age=2592000
